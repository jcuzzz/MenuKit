[gd_resource type="Resource" script_class="MKArchetype" load_steps=3 format=3]

; The demo's ranger archetype. See vanguard.tres for the payload_defaults rule these three share —
; in particular why no archetype may carry a "stats" key.
;
; preview_scene is the shared CC0 mannequin under a green body tint — a ~1.8-unit feet-origin rig, so
; the appearance step's viewport has a subject whose bounds are nothing like cubic.

[ext_resource type="Script" path="res://addons/menu_kit/creation/mk_archetype.gd" id="1_archetype"]
[ext_resource type="PackedScene" path="res://demo/characters/preview_scout.tscn" id="2_preview"]

[resource]
script = ExtResource("1_archetype")
id = &"scout"
display_name = "Scout"
description = "Sees the fight before it starts and picks where it happens. Rewards patience, punishes being cornered."
icon = null
preview_scene = ExtResource("2_preview")
payload_defaults = {
"kit": "bow_and_snares"
}
