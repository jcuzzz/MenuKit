[sub_resource type="Resource" id="slot_menu"]
script = ExtResource("9_slot")
backend_script = ExtResource("10_menu")
params = {
"menu_scene": "res://demo/demo_main.tscn"
}

[sub_resource type="Resource" id="slot_profile"]
script = ExtResource("9_slot")
backend_script = ExtResource("11_profile")
params = {
"file_path": "user://menukit_demo_profiles.json"
}

[sub_resource type="Resource" id="slot_settings"]
script = ExtResource("9_slot")
backend_script = ExtResource("12_settings")
params = {
"file_path": "user://menukit_demo_settings.json"
}

[sub_resource type="Resource" id="slot_pause"]
script = ExtResource("9_slot")
backend_script = ExtResource("13_pause")
params = {}

[sub_resource type="Resource" id="slot_network"]
script = ExtResource("9_slot")
backend_script = ExtResource("14_network")
params = {
"connect_delay": 1.2
}

[sub_resource type="Resource" id="page_play"]
script = ExtResource("2_pagedef")
id = &"play"
title = "Play"
icon = null
scene = ExtResource("5_play")
visible = true
order = 0

[sub_resource type="Resource" id="page_settings"]
script = ExtResource("2_pagedef")
id = &"settings"
title = "Settings"
icon = null
scene = ExtResource("6_settings")
visible = true
order = 10

[sub_resource type="Resource" id="page_credits"]
script = ExtResource("2_pagedef")
