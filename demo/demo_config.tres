[gd_resource type="Resource" script_class="MKConfig" load_steps=12 format=3]

; The demo's own config. Everything that needs host provisioning lives here rather than in the
; addon, which is what keeps the shipped defaults cold-droppable into an empty project.
;
; The Credits page is the shipped proof of the host-added-page path: its scene and its page def are
; both in demo/, and no addon file references either.

[ext_resource type="Script" path="res://addons/menu_kit/core/mk_config.gd" id="1_config"]
[ext_resource type="Script" path="res://addons/menu_kit/core/mk_menu_page_def.gd" id="2_pagedef"]
[ext_resource type="Resource" path="res://addons/menu_kit/themes/default_palette.tres" id="3_palette"]
[ext_resource type="Resource" path="res://addons/menu_kit/themes/default_backdrop_catalog.tres" id="4_backdrops"]
[ext_resource type="PackedScene" path="res://demo/pages/page_play.tscn" id="5_play"]
[ext_resource type="PackedScene" path="res://demo/pages/page_settings.tscn" id="6_settings"]
[ext_resource type="PackedScene" path="res://demo/pages/page_sub.tscn" id="7_sub"]
[ext_resource type="PackedScene" path="res://demo/pages/page_credits.tscn" id="8_credits"]

[sub_resource type="Resource" id="page_play"]
script = ExtResource("2_pagedef")
id = &"play"
title = "Play"
icon = null
scene = ExtResource("5_play")
visible = true
order = 0

[sub_resource type="Resource" id="page_settings"]
script = ExtResource("2_pagedef")
id = &"settings"
title = "Settings"
icon = null
scene = ExtResource("6_settings")
visible = true
order = 10

[sub_resource type="Resource" id="page_credits"]
script = ExtResource("2_pagedef")
id = &"credits"
title = "Credits"
icon = null
scene = ExtResource("8_credits")
visible = true
order = 20

[sub_resource type="Resource" id="page_sub"]
script = ExtResource("2_pagedef")
id = &"sub"
title = "Sub-panel"
icon = null
scene = ExtResource("7_sub")
visible = false
order = 100

[resource]
script = ExtResource("1_config")
menu_backend = null
profile_backend = null
settings_backend = null
network_backend = null
pause_policy = null
palette = ExtResource("3_palette")
backdrop_catalog = ExtResource("4_backdrops")
backdrop_id = &""
pages = Array[Resource]([SubResource("page_play"), SubResource("page_settings"), SubResource("page_credits"), SubResource("page_sub")])
initial_page = &"play"
manage_mouse_mode = true
manage_brightness = true
verbose = false
