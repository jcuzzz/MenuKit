[resource]
script = ExtResource("1_config")
menu_backend = SubResource("slot_menu")
profile_backend = SubResource("slot_profile")
settings_backend = SubResource("slot_settings")
network_backend = SubResource("slot_network")
pause_policy = SubResource("slot_pause")
palette = ExtResource("3_palette")
backdrop_catalog = ExtResource("4_backdrops")
pages = Array[ExtResource("2_pagedef")]([SubResource("page_play"), SubResource("page_characters"), SubResource("page_settings"), SubResource("page_servers"), SubResource("page_credits"), SubResource("page_sub"), SubResource("page_character_create"), SubResource("page_pause")])
initial_page = &"play"
archetypes = Array[ExtResource("1_mdj5m")]([ExtResource("18_vanguard"), ExtResource("19_arcanist"), ExtResource("20_scout")])
creation_steps = Array[ExtResource("17_stepdef")]([SubResource("step_name"), SubResource("step_archetype"), SubResource("step_appearance"), SubResource("step_pointbuy")])
point_buy_schema = ExtResource("21_pointbuy")
