order = 110

[sub_resource type="Resource" id="step_name"]
script = ExtResource("17_stepdef")
id = &"name"
title = "Name"
scene = ExtResource("22_step_name")
required = true
skippable = false

[sub_resource type="Resource" id="step_archetype"]
script = ExtResource("17_stepdef")
id = &"archetype"
title = "Archetype"
scene = ExtResource("23_step_archetype")
required = true
skippable = false

[sub_resource type="Resource" id="step_appearance"]
script = ExtResource("17_stepdef")
id = &"appearance"
title = "Appearance"
scene = ExtResource("24_step_appearance")
required = false
skippable = true

[sub_resource type="Resource" id="step_pointbuy"]
script = ExtResource("17_stepdef")
id = &"pointbuy"
title = "Attributes"
scene = ExtResource("25_step_pointbuy")
required = true
skippable = false

[resource]
script = ExtResource("1_config")
menu_backend = SubResource("slot_menu")
profile_backend = SubResource("slot_profile")
settings_backend = SubResource("slot_settings")
network_backend = SubResource("slot_network")
pause_policy = SubResource("slot_pause")
palette = ExtResource("3_palette")
backdrop_catalog = ExtResource("4_backdrops")
backdrop_id = &""
pages = Array[Resource]([SubResource("page_play"), SubResource("page_characters"), SubResource("page_settings"), SubResource("page_credits"), SubResource("page_sub"), SubResource("page_character_create")])
initial_page = &"play"
archetypes = Array[Resource]([ExtResource("18_vanguard"), ExtResource("19_arcanist"), ExtResource("20_scout")])
creation_steps = Array[Resource]([SubResource("step_name"), SubResource("step_archetype"), SubResource("step_appearance"), SubResource("step_pointbuy")])
point_buy_schema = ExtResource("21_pointbuy")
manage_mouse_mode = true
manage_brightness = true
verbose = false
