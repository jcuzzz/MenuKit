[gd_resource type="Resource" script_class="MKSettingsPageDef" load_steps=9 format=3]

; The demo's Controls page — mirroring the addon default for now.
;
; NO KEYBIND ROWS YET, deliberately. Phase 4 builds MKRebindRow and adds the demo's rebind rows here,
; beside the demo input actions demo/project.godot defines. Authoring KEYBIND rows before the widget
; exists would put an unbuildable row type in a shipped page, and a row naming an absent action warns
; (plan §4.3, §4.4).
;
; When Phase 4 lands, the rows go on THIS page and never on the addon's: an empty project defines only
; ui_* actions, so addon-shipped rebind rows would warn in exactly the cold-drop configuration gate 2
; requires to be silent (plan §3.1). The addon's Controls page stays sensitivity-and-deadzone only.
;
; Every value here is host-consumed: MenuKit stores mouse sensitivity, it does not own a camera to
; apply it to. Deadzone is the one row a host may forget to read — InputMap deadzones are per-action
; and MenuKit does not push this value at them.

[ext_resource type="Script" path="res://addons/menu_kit/settings/mk_settings_page_def.gd" id="1_pagedef"]
[ext_resource type="Script" path="res://addons/menu_kit/settings/mk_setting_def.gd" id="2_rowdef"]

[sub_resource type="Resource" id="row_mouse_header"]
script = ExtResource("2_rowdef")
id = &"controls/header_mouse"
label = "Mouse"
type = 0

[sub_resource type="Resource" id="row_mouse_sensitivity"]
script = ExtResource("2_rowdef")
id = &"controls/mouse_sensitivity"
label = "Mouse Sensitivity"
type = 2
default_value = 1.0
min_value = 0.1
max_value = 5.0
step = 0.05

[sub_resource type="Resource" id="row_invert_y"]
script = ExtResource("2_rowdef")
id = &"controls/invert_y"
label = "Invert Vertical Look"
type = 1
default_value = false

[sub_resource type="Resource" id="row_gamepad_header"]
script = ExtResource("2_rowdef")
id = &"controls/header_gamepad"
label = "Gamepad"
type = 0

[sub_resource type="Resource" id="row_gamepad_sensitivity"]
script = ExtResource("2_rowdef")
id = &"controls/gamepad_sensitivity"
label = "Gamepad Sensitivity"
type = 2
default_value = 1.0
min_value = 0.1
max_value = 5.0
step = 0.05

[sub_resource type="Resource" id="row_gamepad_deadzone"]
script = ExtResource("2_rowdef")
id = &"controls/gamepad_deadzone"
label = "Stick Deadzone"
type = 2
default_value = 0.2
min_value = 0.0
max_value = 0.9
step = 0.01
tooltip = "Stored for the host to apply — InputMap deadzones are per-action and MenuKit does not write them."

[resource]
script = ExtResource("1_pagedef")
id = &"controls"
title = "Controls"
icon = null
rows = Array[Resource]([SubResource("row_mouse_header"), SubResource("row_mouse_sensitivity"), SubResource("row_invert_y"), SubResource("row_gamepad_header"), SubResource("row_gamepad_sensitivity"), SubResource("row_gamepad_deadzone")])
