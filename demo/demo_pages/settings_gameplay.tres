[gd_resource type="Resource" script_class="MKSettingsPageDef" format=3 uid="uid://coutr3xrgoshv"]

[ext_resource type="Script" uid="uid://bwo65fq24plel" path="res://addons/menu_kit/settings/mk_settings_page_def.gd" id="1_pagedef"]
[ext_resource type="Script" uid="uid://4183s86d76tc" path="res://addons/menu_kit/settings/mk_setting_def.gd" id="2_rowdef"]
[ext_resource type="PackedScene" path="res://addons/menu_kit/settings/mk_example_custom_row.tscn" id="3_customrow"]

[sub_resource type="Resource" id="row_general_header"]
script = ExtResource("2_rowdef")
id = &"gameplay/header_general"
label = "General"
type = 0
default_value = null

[sub_resource type="Resource" id="row_difficulty"]
script = ExtResource("2_rowdef")
id = &"gameplay/difficulty"
label = "Difficulty"
type = 3
default_value = 1
options = Array[String](["Easy", "Normal", "Hard", "Nightmare"])
option_values = [0, 1, 2, 3]

[sub_resource type="Resource" id="row_subtitles"]
script = ExtResource("2_rowdef")
id = &"gameplay/subtitles"
label = "Subtitles"
default_value = true

[sub_resource type="Resource" id="row_subtitle_size"]
script = ExtResource("2_rowdef")
id = &"gameplay/subtitle_size"
label = "Subtitle Size"
type = 2
default_value = 1.0
min_value = 0.5
max_value = 2.0
step = 0.05
tooltip = "Hidden while subtitles are off — the visible_condition_id below is the mechanism."
visible_condition_id = &"gameplay/subtitles"

[sub_resource type="Resource" id="row_profile_header"]
script = ExtResource("2_rowdef")
id = &"gameplay/header_profile"
label = "Profile"
type = 0
default_value = null

[sub_resource type="Resource" id="row_player_name"]
script = ExtResource("2_rowdef")
id = &"gameplay/player_name"
label = "Display Name"
type = 5
default_value = "Marine"
tooltip = "The TEXT row type. Stored verbatim; MenuKit does not validate or sanitise it."

[sub_resource type="Resource" id="row_custom_example"]
script = ExtResource("2_rowdef")
id = &"gameplay/custom_example"
label = "Custom Row"
type = 6
default_value = 5.0
max_value = 10.0
step = 1.0
tooltip = "A host-authored widget bound through _mk_bind — the escape hatch that keeps the type enum closed."
custom_scene = ExtResource("3_customrow")

[resource]
script = ExtResource("1_pagedef")
id = &"gameplay"
title = "Gameplay"
rows = Array[ExtResource("2_rowdef")]([SubResource("row_general_header"), SubResource("row_difficulty"), SubResource("row_subtitles"), SubResource("row_subtitle_size"), SubResource("row_profile_header"), SubResource("row_player_name"), SubResource("row_custom_example")])
