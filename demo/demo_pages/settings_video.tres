[gd_resource type="Resource" script_class="MKSettingsPageDef" format=3 uid="uid://drlw2dhytg30e"]

[ext_resource type="Script" uid="uid://bwo65fq24plel" path="res://addons/menu_kit/settings/mk_settings_page_def.gd" id="1_pagedef"]
[ext_resource type="Script" uid="uid://4183s86d76tc" path="res://addons/menu_kit/settings/mk_setting_def.gd" id="2_rowdef"]

[sub_resource type="Resource" id="row_display_header"]
script = ExtResource("2_rowdef")
id = &"video/header_display"
label = "Display"
type = 0
default_value = null

[sub_resource type="Resource" id="row_window_mode"]
script = ExtResource("2_rowdef")
id = &"video/window_mode"
label = "Window Mode"
type = 3
default_value = 0
options = Array[String](["Windowed", "Fullscreen", "Exclusive Fullscreen"])
option_values = [0, 3, 4]
tooltip = "Exclusive fullscreen can reduce input latency on some systems."
requires_confirm = true

[sub_resource type="Resource" id="row_resolution"]
script = ExtResource("2_rowdef")
id = &"video/resolution"
label = "Resolution"
type = 3
default_value = Vector2i(1920, 1080)
options = Array[String](["1280 x 720", "1920 x 1080", "2560 x 1440", "3840 x 2160"])
option_values = [Vector2i(1280, 720), Vector2i(1920, 1080), Vector2i(2560, 1440), Vector2i(3840, 2160)]
tooltip = "Only applies in windowed mode."
requires_confirm = true

[sub_resource type="Resource" id="row_vsync"]
script = ExtResource("2_rowdef")
id = &"video/vsync"
label = "V-Sync"
default_value = true
tooltip = "Removes tearing at the cost of input latency."

[sub_resource type="Resource" id="row_max_fps"]
script = ExtResource("2_rowdef")
id = &"video/max_fps"
label = "Max FPS"
type = 3
default_value = 0
options = Array[String](["Unlimited", "30", "60", "120", "144", "240"])
option_values = [0, 30, 60, 120, 144, 240]
tooltip = "0 means unlimited."

[sub_resource type="Resource" id="row_camera_header"]
script = ExtResource("2_rowdef")
id = &"video/header_camera"
label = "Camera"
type = 0
default_value = null

[sub_resource type="Resource" id="row_fov"]
script = ExtResource("2_rowdef")
id = &"video/fov"
label = "Field of View"
type = 2
default_value = 75.0
min_value = 60.0
max_value = 120.0
step = 1.0
tooltip = "A plain value the host applies to its own camera — MenuKit stores it and does not own a camera."

[sub_resource type="Resource" id="row_brightness"]
script = ExtResource("2_rowdef")
id = &"video/brightness"
label = "Brightness"
type = 2
default_value = 1.0
min_value = 0.5
max_value = 2.0
tooltip = "Adjust until the darkest band of the reference gradient is barely visible."

[resource]
script = ExtResource("1_pagedef")
id = &"video"
title = "Video"
rows = Array[ExtResource("2_rowdef")]([SubResource("row_display_header"), SubResource("row_window_mode"), SubResource("row_resolution"), SubResource("row_vsync"), SubResource("row_max_fps"), SubResource("row_camera_header"), SubResource("row_fov"), SubResource("row_brightness")])
