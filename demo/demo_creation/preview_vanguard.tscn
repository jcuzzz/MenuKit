[gd_scene load_steps=2 format=3]

; A TEST FIXTURE, not shipped content: retained as tests/test_preview_viewport.gd's CSG
; deferred-bounds subject. No archetype points at it any more — the product path is the three
; rigged scenes in demo/characters/, and its two siblings (preview_arcanist/preview_scout) were
; deleted with that re-point.
;
; Why it survives as a .tscn rather than becoming a node built inside the test: CSG builds its mesh
; on a DEFERRED call, so get_aabb() reads zero on the frame the node is added, and the widget's
; second-pass framing exists for exactly that. A MeshInstance3D fixture measures immediately and
; cannot reproduce the failure mode; a CSG node hand-built in the suite could, but the suite's
; other CSG fixtures already cover the hand-built shape and this one additionally proves the widget
; survives a real authored .tscn arriving through load().
;
; MKPreviewViewport assumes nothing about what it is shown — no rig, no skeleton, no scale
; convention — which is why a box and a mannequin are both legitimate subjects for it.

[sub_resource type="StandardMaterial3D" id="mat_vanguard"]
albedo_color = Color(0.78, 0.34, 0.28, 1)

[node name="PreviewVanguard" type="CSGBox3D"]
size = Vector3(1.1, 1.1, 1.1)
material = SubResource("mat_vanguard")
