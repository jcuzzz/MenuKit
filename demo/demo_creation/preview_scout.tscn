[gd_scene load_steps=2 format=3]

; The Scout's preview subject: a cylinder. See preview_vanguard.tscn for why the demo's previews are
; bare CSG primitives with authored materials and no scripts.
;
; Taller than it is wide, deliberately: a non-cubic subject is the one that would clip on a naive
; fit, so the demo carries a case the frame-from-bounds math has to actually solve.

[sub_resource type="StandardMaterial3D" id="mat_scout"]
