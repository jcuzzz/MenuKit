[gd_resource type="Resource" script_class="MKStatSchema" format=3 uid="uid://dsmn1hhp4c3c0"]

[ext_resource type="Script" uid="uid://cml6qi2ardaj0" path="res://addons/menu_kit/creation/mk_stat_schema.gd" id="1_schema"]
[ext_resource type="Script" uid="uid://0axfxd4ismwu" path="res://addons/menu_kit/creation/mk_stat_def.gd" id="2_statdef"]

[sub_resource type="Resource" id="stat_might"]
script = ExtResource("2_statdef")
id = &"might"
label = "Might"
description = "Raw physical force — what you can lift, break, and shrug off."
min_value = 1
max_value = 6
effect_hint = "Heavier hits, and more room to be wrong about a fight."

[sub_resource type="Resource" id="stat_finesse"]
script = ExtResource("2_statdef")
id = &"finesse"
label = "Finesse"
description = "Precision and timing, in the hands and on the feet."
min_value = 1
max_value = 6
effect_hint = "Faster reactions, and openings other people do not get."

[sub_resource type="Resource" id="stat_wits"]
script = ExtResource("2_statdef")
id = &"wits"
label = "Wits"
description = "Reading a situation, and remembering what worked last time."
min_value = 1
max_value = 6
effect_hint = "Better information, sooner — and more of it retained."

[resource]
script = ExtResource("1_schema")
stats = Array[ExtResource("2_statdef")]([SubResource("stat_might"), SubResource("stat_finesse"), SubResource("stat_wits")])
