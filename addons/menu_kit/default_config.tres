[sub_resource type="Resource" id="archetype_traveler"]
script = ExtResource("14_archetype")
id = &"traveler"
display_name = "Traveler"
description = "Someone who set out with what they could carry. No specialism, no history you have to honour — replace this the moment you know what your game's classes are."
icon = null
preview_scene = null
payload_defaults = {}

[resource]
script = ExtResource("1_config")
menu_backend = SubResource("slot_menu")
profile_backend = SubResource("slot_profile")
settings_backend = SubResource("slot_settings")
network_backend = null
pause_policy = SubResource("slot_pause")
palette = ExtResource("4_palette")
backdrop_catalog = ExtResource("5_backdrops")
backdrop_id = &""
pages = Array[Resource]([SubResource("page_welcome"), SubResource("page_settings"), SubResource("page_characters"), SubResource("page_character_create"), SubResource("page_pause")])
initial_page = &"welcome"
archetypes = Array[Resource]([SubResource("archetype_traveler")])
creation_steps = Array[Resource]([])
point_buy_schema = null
manage_mouse_mode = true
manage_brightness = true
verbose = false
