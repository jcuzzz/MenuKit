[gd_resource type="Resource" script_class="MKConfig" load_steps=11 format=3]

; The host's copy-me starting point. Every value here is chosen so that copying addons/menu_kit/
; alone into an empty Godot project boots with zero errors and zero warnings (ship gate 2) —
; verified by cold drop, not assumed.
;
; Four slots are assigned; the NETWORK slot ships empty on purpose (§3.1). An unassigned network
; slot hides the server browser entirely, which is the right first impression for a single-player
; Doom-like — and MKStubNetworkBackend still ships as the reference implementation a host or the
; demo can point a slot at. "Shipped default" means available, not active.
;
; MKSceneMenuBackend's params are empty: it names no scene, because an addon file naming the demo
; would break the isolation rule and fail gate 1 by construction. Unassigned params are valid
; config — they warn when Play is clicked, never at boot, which is what keeps gate 2 passable.

[ext_resource type="Script" path="res://addons/menu_kit/core/mk_config.gd" id="1_config"]
[ext_resource type="Script" path="res://addons/menu_kit/core/mk_menu_page_def.gd" id="2_pagedef"]
[ext_resource type="Script" path="res://addons/menu_kit/core/mk_backend_slot.gd" id="3_slot"]
[ext_resource type="Resource" path="res://addons/menu_kit/themes/default_palette.tres" id="4_palette"]
[ext_resource type="Resource" path="res://addons/menu_kit/themes/default_backdrop_catalog.tres" id="5_backdrops"]
[ext_resource type="PackedScene" path="res://addons/menu_kit/panels/mk_welcome_page.tscn" id="6_welcome"]
[ext_resource type="Script" path="res://addons/menu_kit/backends/defaults/mk_scene_menu_backend.gd" id="7_menu"]
[ext_resource type="Script" path="res://addons/menu_kit/backends/defaults/mk_json_profile_backend.gd" id="8_profile"]
[ext_resource type="Script" path="res://addons/menu_kit/backends/defaults/mk_json_settings_backend.gd" id="9_settings"]
[ext_resource type="Script" path="res://addons/menu_kit/backends/defaults/mk_tree_pause_policy.gd" id="10_pause"]

[sub_resource type="Resource" id="slot_menu"]
script = ExtResource("3_slot")
backend_script = ExtResource("7_menu")
params = {}

[sub_resource type="Resource" id="slot_profile"]
script = ExtResource("3_slot")
backend_script = ExtResource("8_profile")
params = {}

[sub_resource type="Resource" id="slot_settings"]
script = ExtResource("3_slot")
backend_script = ExtResource("9_settings")
params = {}

[sub_resource type="Resource" id="slot_pause"]
script = ExtResource("3_slot")
backend_script = ExtResource("10_pause")
params = {}

[sub_resource type="Resource" id="page_welcome"]
script = ExtResource("2_pagedef")
id = &"welcome"
title = "Welcome"
icon = null
scene = ExtResource("6_welcome")
visible = true
order = 0

[resource]
script = ExtResource("1_config")
menu_backend = SubResource("slot_menu")
profile_backend = SubResource("slot_profile")
settings_backend = SubResource("slot_settings")
network_backend = null
pause_policy = SubResource("slot_pause")
palette = ExtResource("4_palette")
backdrop_catalog = ExtResource("5_backdrops")
backdrop_id = &""
pages = Array[Resource]([SubResource("page_welcome")])
initial_page = &"welcome"
manage_mouse_mode = true
manage_brightness = true
verbose = false
