[gd_resource type="Resource" script_class="MKConfig" load_steps=4 format=3]

; The host's copy-me starting point. Every value here is chosen so that copying addons/menu_kit/
; alone into an empty Godot project boots with zero errors and zero warnings (ship gate 2).
;
; All five backend slots ship UNASSIGNED at Phase 1: the shipped default implementations land in
; Phase 2, and an unassigned slot is valid config — it warns when something invokes it, never at
; boot. The network slot stays empty permanently by design, so a cold drop has no server browser.

[ext_resource type="Script" path="res://addons/menu_kit/core/mk_config.gd" id="1_config"]
[ext_resource type="Resource" path="res://addons/menu_kit/themes/default_palette.tres" id="2_palette"]
[ext_resource type="Resource" path="res://addons/menu_kit/themes/default_backdrop_catalog.tres" id="3_backdrops"]

[resource]
script = ExtResource("1_config")
menu_backend = null
profile_backend = null
settings_backend = null
network_backend = null
pause_policy = null
palette = ExtResource("2_palette")
backdrop_catalog = ExtResource("3_backdrops")
backdrop_id = &""
pages = Array[Resource]([])
initial_page = &""
manage_mouse_mode = true
manage_brightness = true
verbose = false
