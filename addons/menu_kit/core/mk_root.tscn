[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/menu_kit/core/mk_root.gd" id="1_mkroot"]

; The shell. Children are built in code because pages, tabs and backends are all data-driven — a
; pre-baked tree here could only drift from what the script rebuilds at boot.
; process_mode = 3 is PROCESS_MODE_ALWAYS and is inherited by the whole subtree (plan §4.2a).

[node name="MKRoot" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_mkroot")
