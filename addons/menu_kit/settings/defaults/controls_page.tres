[gd_resource type="Resource" script_class="MKSettingsPageDef" load_steps=9 format=3]

; The shipped Controls page (plan §3.1, §4.3) — NO KEYBIND ROWS, for the same reason the Audio page
; ships Master-only.
;
; A KEYBIND row names an InputMap action through action_name, an empty project defines only the ui_*
; actions, and §4.8 mandates that an absent action warns. Addon-shipped rebind rows would therefore
; fire warnings in exactly the empty-project configuration gate 2 requires to be silent. The demo
; carries the rebind rows beside the demo actions its own project.godot defines.
;
; Every row here is a PLAIN value: MenuKit stores and persists it, and the host's camera and input
; code consume it off MKSettingsBackend.setting_changed. MenuKit owns no camera, so it cannot own
; sensitivity — but it can own the slider, the persistence, and the reset path, which is the whole
; division of labour the backend abstraction exists for.

[ext_resource type="Script" path="res://addons/menu_kit/settings/mk_settings_page_def.gd" id="1_pagedef"]
[ext_resource type="Script" path="res://addons/menu_kit/settings/mk_setting_def.gd" id="2_rowdef"]

[sub_resource type="Resource" id="row_mouse_header"]
