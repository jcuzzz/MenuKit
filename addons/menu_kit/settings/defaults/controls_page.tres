label = "Mouse"
type = 0
default_value = null
min_value = 0.0
max_value = 1.0
step = 0.01
options = Array[String]([])
option_values = []
tooltip = ""
action_name = &""
requires_confirm = false
visible_condition_id = &""
custom_scene = null

