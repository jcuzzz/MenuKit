[ext_resource type="Script" uid="uid://bwo65fq24plel" path="res://addons/menu_kit/settings/mk_settings_page_def.gd" id="1_pagedef"]
[ext_resource type="Script" uid="uid://4183s86d76tc" path="res://addons/menu_kit/settings/mk_setting_def.gd" id="2_rowdef"]

[sub_resource type="Resource" id="row_mouse_header"]
script = ExtResource("2_rowdef")
label = "Mouse"
type = 0
default_value = null

[sub_resource type="Resource" id="row_mouse_sensitivity"]
script = ExtResource("2_rowdef")
id = &"controls/mouse_sensitivity"
label = "Mouse Sensitivity"
type = 2
default_value = 1.0
min_value = 0.1
max_value = 5.0
step = 0.05
tooltip = "Multiplier applied by your game's camera to relative mouse motion."

[sub_resource type="Resource" id="row_invert_y"]
script = ExtResource("2_rowdef")
id = &"controls/invert_y"
label = "Invert Vertical Look"
default_value = false
tooltip = "Applies to both mouse and gamepad look."

[sub_resource type="Resource" id="row_gamepad_header"]
script = ExtResource("2_rowdef")
label = "Gamepad"
type = 0
default_value = null

[sub_resource type="Resource" id="row_gamepad_sensitivity"]
script = ExtResource("2_rowdef")
id = &"controls/gamepad_sensitivity"
label = "Gamepad Sensitivity"
type = 2
default_value = 1.0
min_value = 0.1
max_value = 5.0
step = 0.05
tooltip = "Multiplier applied to right-stick look."

[sub_resource type="Resource" id="row_gamepad_deadzone"]
script = ExtResource("2_rowdef")
id = &"controls/gamepad_deadzone"
label = "Gamepad Deadzone"
type = 2
default_value = 0.2
max_value = 0.9
tooltip = "Stick movement below this fraction is ignored. Raise it if the view drifts at rest."

[resource]
script = ExtResource("1_pagedef")
id = &"controls"
title = "Controls"
rows = Array[ExtResource("2_rowdef")]([SubResource("row_mouse_header"), SubResource("row_mouse_sensitivity"), SubResource("row_invert_y"), SubResource("row_gamepad_header"), SubResource("row_gamepad_sensitivity"), SubResource("row_gamepad_deadzone")])
