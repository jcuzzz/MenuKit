action_name = &""
requires_confirm = false
visible_condition_id = &""
custom_scene = null

[sub_resource type="Resource" id="row_custom_example"]
script = ExtResource("2_rowdef")
id = &"gameplay/example_custom_value"
label = "Custom Row Example"
type = 6
default_value = 5.0
