[resource]
script = ExtResource("1_pagedef")
id = &"gameplay"
title = "Gameplay"
icon = null
rows = Array[ExtResource("2_rowdef")]([SubResource("row_header"), SubResource("row_subtitles"), SubResource("row_subtitle_size"), SubResource("row_difficulty"), SubResource("row_player_name"), SubResource("row_custom_example")])
