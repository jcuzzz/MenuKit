option_values = [0, 1, 2, 3]
tooltip = "Read by your game. MenuKit stores the choice and assigns it no meaning."
action_name = &""
requires_confirm = false
visible_condition_id = &""
custom_scene = null

[sub_resource type="Resource" id="row_player_name"]
