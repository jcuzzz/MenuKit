default_value = 1.0
min_value = 0.5
max_value = 2.0
step = 0.05
options = Array[String]([])
option_values = []
tooltip = "Scale applied to subtitle text. Visible only while subtitles are on."
action_name = &""
requires_confirm = false
visible_condition_id = &"gameplay/subtitles"
custom_scene = null

[sub_resource type="Resource" id="row_difficulty"]
script = ExtResource("2_rowdef")
id = &"gameplay/difficulty"
label = "Difficulty"
type = 3
default_value = 1
min_value = 0.0
max_value = 1.0
step = 0.01
